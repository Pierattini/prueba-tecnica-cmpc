// Modelo relacional - CMPC Libros
// Pegar en https://dbdiagram.io para visualizarlo

Project cmpc_books {
  database_type: 'PostgreSQL'
  Note: 'Inventario de libros. Extensión pg_trgm para búsqueda por similitud.'
}

Enum role {
  ADMIN
  USER
}

Enum audit_action {
  CREATE
  UPDATE
  DELETE
  RESTORE
  UPLOAD_IMAGE
}

Table users {
  id uuid [pk]
  email varchar(255) [not null, unique]
  name varchar(120) [not null]
  password_hash text [not null, note: 'bcrypt']
  role role [not null, default: 'USER']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
}

Table authors {
  id uuid [pk]
  name varchar(150) [not null, unique]
  created_at timestamp [not null, default: `now()`]

  indexes {
    name [type: gin, name: 'authors_name_trgm_idx', note: 'gin_trgm_ops - búsqueda por autor']
  }
}

Table publishers {
  id uuid [pk]
  name varchar(150) [not null, unique]
  created_at timestamp [not null, default: `now()`]
}

Table genres {
  id uuid [pk]
  name varchar(80) [not null, unique]
  created_at timestamp [not null, default: `now()`]
}

Table books {
  id uuid [pk]
  title varchar(255) [not null]
  author_id uuid [not null, ref: > authors.id]
  publisher_id uuid [not null, ref: > publishers.id]
  genre_id uuid [not null, ref: > genres.id]
  price decimal(10,2) [not null]
  stock int [not null, default: 0]
  is_available boolean [not null, default: false, note: 'derivado de stock > 0, persistido para indexar']
  image_url varchar(500)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null]
  deleted_at timestamp [note: 'soft delete: NULL = activo']

  indexes {
    author_id
    publisher_id
    genre_id
    is_available
    price
    deleted_at
    created_at
    title [type: gin, name: 'books_title_trgm_idx', note: 'gin_trgm_ops - ILIKE %texto%']
  }
}

Table audit_logs {
  id uuid [pk]
  user_id uuid [ref: > users.id, note: 'ON DELETE SET NULL']
  action audit_action [not null]
  entity varchar(50) [not null]
  entity_id varchar(64) [not null]
  changes jsonb [note: 'snapshot (CREATE/DELETE) o diff {campo: {from, to}} (UPDATE)']
  ip varchar(64)
  created_at timestamp [not null, default: `now()`]

  indexes {
    (entity, entity_id)
    user_id
    created_at
  }
}
