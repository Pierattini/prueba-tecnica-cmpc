# variables que lee docker-compose.yml (todas tienen valor por defecto)
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_books
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=8080
# en produccion usar un valor aleatorio de al menos 32 caracteres
JWT_SECRET=solo-para-desarrollo-cambiar-en-produccion-1234
JWT_EXPIRES_IN=3600
CORS_ORIGIN=http://localhost:8080
RUN_SEED=true
